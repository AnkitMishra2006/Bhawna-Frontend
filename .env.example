# ── Frontend environment variables (template) ─────────────────────────────────
# Copy to .env.local for local dev, or set these in your host's env settings
# (e.g. Vercel → Project → Settings → Environment Variables) for deployment.
#
# To deploy, change ONLY these URLs to your deployed backend URLs. The app
# derives the WebSocket URL automatically (ws:// for http, wss:// for https).

# Full base URL of the custom EmotionNet backend.
#   local:  http://localhost:8000
#   deploy: https://your-custom-backend.onrender.com
VITE_CUSTOM_BACKEND_URL=http://localhost:8000

# Full base URL of the DeepFace backend.
#   local:  http://localhost:8001
#   deploy: https://your-deepface-backend.onrender.com
VITE_DEEPFACE_BACKEND_URL=http://localhost:8001

# Optional: override the auth/REST backend separately.
# If unset, the app uses VITE_CUSTOM_BACKEND_URL.
# VITE_AUTH_BACKEND_URL=http://localhost:8000
